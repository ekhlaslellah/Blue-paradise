المقابلات interviews: interview_id PK؛ application_id FK؛ scheduled_at؛ panel_alias؛ status؛ rubric_version؛ recommendation.
التقييمات interview_scores: score_id PK؛ interview_id FK؛ criterion_id FK؛ score؛ evaluator_alias؛ rationale.
الحضور attendance: attendance_id PK؛ employee_id FK؛ work_date؛ scheduled_hours؛ actual_hours؛ status؛ approved_by.
الإجازات leave_requests: leave_id PK؛ employee_id FK؛ leave_type؛ start_date؛ end_date؛ requested_days؛ status؛ manager_approval.
التدريب training_catalog: training_id PK؛ title؛ skill_category؛ duration_hours؛ delivery_mode.
الالتحاق بالتدريب training_enrollments: enrollment_id PK؛ employee_id FK؛ training_id FK؛ enrollment_date؛ completion_status؛ score_before؛ score_after.
